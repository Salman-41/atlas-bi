ATLAS_JWT_SECRET=
ATLAS_DATA_DIR=data
ATLAS_DATABASE_URL=sqlite:///data/app.db
ATLAS_REDIS_URL=redis://localhost:6379/0
NEXT_PUBLIC_API_URL=http://localhost:8000
# Compose requires explicit PostgreSQL password; do not commit real credentials.
POSTGRES_PASSWORD=
